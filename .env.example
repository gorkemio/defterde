# Yerel: http://localhost:4321 — üretim: https://defterde.com
PUBLIC_ORIGIN=http://localhost:4321
HOST=127.0.0.1
PORT=4321
# DB olmadan da çalışır: satırı silersen oyunlar ve başlangıç kataloğu açılır, yönetim kapalı kalır.
DATABASE_URL=postgres://defterde:CHANGE_ME@127.0.0.1:5432/defterde
SNAPSHOT_DIR=./var
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Kullanıcı adı değil, sabit sayısal GitHub kullanıcı ID'si
GITHUB_OWNER_ID=
# Ters vekil arkasında: güvenilen vekil hop sayısı (ör. 1) veya virgüllü IP/CIDR listesi
TRUST_PROXY=
# Sitedeki GitHub bağlantısı (build sırasında gömülür); çatallar kendi depolarını yazabilir
PUBLIC_REPO_URL=
